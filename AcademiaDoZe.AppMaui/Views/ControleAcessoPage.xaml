<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs.ControleAcesso;assembly=AcademiaDoZe.Application"
    x:Class="AcademiaDoZe.AppMaui.Views.ControleAcessoPage"
    x:DataType="vm:ControleAcessoViewModel"
    Title="Controle de Acesso">

    <ContentPage.Resources>

        <Style x:Key="AcessoTextoSecundario" TargetType="Label">
            <Setter Property="FontFamily" Value="GothicBody"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource TextSecondary}}"/>
        </Style>

        <Style x:Key="AcessoDestaque" TargetType="Label">
            <Setter Property="FontFamily" Value="GothicBodyBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryDark},
                                            Dark={StaticResource SecondaryDarkText}}"/>
        </Style>

        <Style x:Key="AcessoSeparador" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1"/>
            <Setter Property="BackgroundColor" Value="{StaticResource Border}"/>
            <Setter Property="Opacity" Value="0.6"/>
        </Style>

        <Style x:Key="AcessoBotaoSelecao" TargetType="Button">
            <Setter Property="FontFamily" Value="GothicBodyBold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="HeightRequest" Value="45"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource Gray400}}"/>
            <Setter Property="BorderColor" Value="{StaticResource Border}"/>
            <Setter Property="BorderWidth" Value="1"/>
        </Style>

        <Style x:Key="AcessoPicker" TargetType="Picker">
            <Setter Property="FontFamily" Value="GothicBody"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="HeightRequest" Value="70"/>
            <Setter Property="MinimumHeightRequest" Value="70"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource Gray900},
                                            Dark={StaticResource TextPrimary}}"/>
            <Setter Property="TitleColor"
                    Value="{AppThemeBinding Light={StaticResource Gray600},
                                            Dark={StaticResource TextSecondary}}"/>
        </Style>

    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="0,10,0,25">

            <Label
                Text="Controle de Acesso"
                Style="{StaticResource SubHeadline}"
                FontSize="28"
                Margin="15,0,15,5"/>

            <!-- TIPO DE PESSOA -->
            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,5">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Controle de Acesso / Catraca"
                        Style="{StaticResource SubHeadline}"
                        FontSize="22"/>

                    <Label
                        Text="Selecione o tipo de pessoa para registrar o acesso."
                        Style="{StaticResource AcessoTextoSecundario}"
                        HorizontalTextAlignment="Center"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="Aluno"
                            Style="{StaticResource AcessoBotaoSelecao}"
                            Command="{Binding SelecionarAlunoCommand}">

                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding AlunoSelecionado}"
                                    Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource White}"/>
                                    <Setter Property="BorderWidth" Value="0"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Text="Colaborador"
                            Style="{StaticResource AcessoBotaoSelecao}"
                            Command="{Binding SelecionarColaboradorCommand}">

                            <Button.Triggers>
                                <DataTrigger
                                    TargetType="Button"
                                    Binding="{Binding ColaboradorSelecionado}"
                                    Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource Primary}"/>
                                    <Setter Property="TextColor"
                                            Value="{StaticResource White}"/>
                                    <Setter Property="BorderWidth" Value="0"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>

                    </Grid>

                    <Border
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200},
                                                         Dark={StaticResource SurfaceElevated}}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="10">

                        <Label
                            Text="{Binding TipoAtual, StringFormat='Modo selecionado: {0}'}"
                            Style="{StaticResource AcessoDestaque}"
                            HorizontalTextAlignment="Center"/>

                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- LOCALIZAR PESSOA -->
            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,5">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Localizar Pessoa"
                        Style="{StaticResource SubHeadline}"
                        FontSize="22"/>

                    <Label
                        Text="Pesquise pelo nome, CPF ou código:"
                        Style="{StaticResource AcessoTextoSecundario}"/>

                    <SearchBar
                        Placeholder="Nome, CPF ou código..."
                        Text="{Binding TermoBusca}"
                        SearchCommand="{Binding BuscarCommand}"/>

                    <Button
                        Text="Buscar"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding BuscarCommand}"
                        HeightRequest="45"/>

                    <BoxView Style="{StaticResource AcessoSeparador}"/>

                    <!-- SOMENTE O PICKER, SEM LABEL EXTERNO -->
                    <Picker
                        x:DataType="{x:Null}"
                        Title="Selecione uma pessoa..."
                        Style="{StaticResource AcessoPicker}"
                        ItemsSource="{Binding Pessoas}"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedItem="{Binding PessoaSelecionada}"/>

                </VerticalStackLayout>
            </Border>

            <!-- IDENTIFICAÇÃO -->
            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,5"
                IsVisible="{Binding TemPessoaSelecionada}">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Identificação e Liberação"
                        Style="{StaticResource SubHeadline}"
                        FontSize="22"/>

                    <Grid ColumnDefinitions="80,*" ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            WidthRequest="75"
                            HeightRequest="75"
                            Stroke="{StaticResource Accent}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 38">

                            <Image
                                Source="{Binding PessoaSelecionada.FotoUrl}"
                                Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="6"
                            VerticalOptions="Center">

                            <Label
                                Text="{Binding PessoaSelecionada.Nome}"
                                FontFamily="GothicBodyBold"
                                FontSize="17"/>

                            <Label
                                Text="{Binding PessoaSelecionada.Cpf, StringFormat='CPF: {0}'}"
                                Style="{StaticResource AcessoTextoSecundario}"/>

                            <Label
                                Text="{Binding PessoaSelecionada.Situacao}"
                                Style="{StaticResource AcessoDestaque}"/>

                        </VerticalStackLayout>

                    </Grid>

                    <BoxView Style="{StaticResource AcessoSeparador}"/>

                    <Button
                        Text="{Binding TextoBotao}"
                        Style="{StaticResource ButtonPrimary}"
                        Command="{Binding RegistrarAcessoCommand}"
                        IsEnabled="{Binding PodeRegistrar}"
                        HeightRequest="50"/>

                </VerticalStackLayout>
            </Border>

            <!-- MENSAGENS -->
            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,5"
                IsVisible="{Binding MensagemVisivel}">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                    <Label
                        Grid.Column="0"
                        Text="●"
                        FontSize="18"
                        TextColor="{StaticResource Accent}"
                        VerticalOptions="Center"/>

                    <Label
                        Grid.Column="1"
                        Text="{Binding Mensagem}"
                        FontSize="13"
                        LineBreakMode="WordWrap"
                        VerticalOptions="Center"/>

                </Grid>
            </Border>

            <!-- HISTÓRICO DE ENTRADAS E SAÍDAS -->
            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,5">

                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">

                        <Label
                            Grid.Column="0"
                            Text="Acessos Registrados Hoje"
                            Style="{StaticResource SubHeadline}"
                            FontSize="21"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            VerticalOptions="Center"/>

                        <Button
                            Grid.Column="1"
                            Text="Atualizar"
                            Style="{StaticResource ButtonSecondary}"
                            Command="{Binding AtualizarCommand}"
                            HeightRequest="40"
                            FontSize="13"
                            Padding="12,6"/>

                    </Grid>

                    <BoxView Style="{StaticResource AcessoSeparador}"/>

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Historico}"
                        Spacing="10">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RegistroAcessoDto">

                                <VerticalStackLayout Spacing="10">

                                    <Grid
                                        ColumnDefinitions="25,*,Auto"
                                        ColumnSpacing="10"
                                        Padding="0,8">

                                        <Label
                                            Grid.Column="0"
                                            Text="●"
                                            FontSize="14"
                                            VerticalOptions="Center">

                                            <Label.Triggers>
                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding EhSaida}"
                                                    Value="True">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>

                                                <DataTrigger
                                                    TargetType="Label"
                                                    Binding="{Binding EhSaida}"
                                                    Value="False">
                                                    <Setter
                                                        Property="TextColor"
                                                        Value="{StaticResource Accent}"/>
                                                </DataTrigger>
                                            </Label.Triggers>

                                        </Label>

                                        <VerticalStackLayout
                                            Grid.Column="1"
                                            Spacing="5">

                                            <Label
                                                Text="{Binding NomePessoa}"
                                                FontFamily="GothicBodyBold"
                                                FontSize="15"/>

                                            <Label
                                                Text="{Binding Descricao}"
                                                FontFamily="GothicBody"
                                                FontSize="13"
                                                TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                            Dark={StaticResource TextSecondary}}"/>

                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="{Binding Horario}"
                                            FontFamily="GothicBodyBold"
                                            FontSize="14"
                                            TextColor="{AppThemeBinding Light={StaticResource Gray900},
                                                                        Dark={StaticResource TextPrimary}}"
                                            VerticalOptions="Center"/>

                                    </Grid>

                                    <BoxView
                                        HeightRequest="1"
                                        BackgroundColor="{StaticResource Border}"
                                        Opacity="0.4"/>

                                </VerticalStackLayout>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <ActivityIndicator
                IsRunning="{Binding Carregando}"
                IsVisible="{Binding Carregando}"
                HorizontalOptions="Center"
                Margin="0,10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
